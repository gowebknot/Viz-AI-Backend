DB_URI=YOUR_DATABASE_URI
SECRET_KEY =YOUR_SECRET_KEY
REFRESH_SECRET_KEY =YOUR_REFRESH_SECRET_KEY
ALGORITHM = "HS256"
ACCESS_TOKEN_EXPIRE_MINUTES = 60  
REFRESH_TOKEN_EXPIRE_DAYS = 7
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY

# Knowledge graph (PDF + DOCX)
KG_EXTRACT_URL=http://localhost:8001/api/knowledge-graph/extract
KG_EXTRACT_TIMEOUT=600
KG_UPLOAD_DIR=uploads/knowledge_graphs
KG_MAX_PAGES=20
KG_MAX_FILE_MB=20
KG_DOCX_WORDS_PER_PAGE=500

# Neo4j AuraDB (required for KG upload/delete — fail-closed dual-write)
NEO4J_URI=neo4j+s://YOUR_DATABASE_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_AURADB_PASSWORD
NEO4J_DATABASE=neo4j

# Client connector flow (optional; everything below is off unless CONNECTOR_GATEWAY_ENABLED=true).
# The gateway keeps its sessions in this process: run ONE uvicorn worker while it is on.
# CONNECTOR_GATEWAY_ENABLED=true
# CONNECTOR_GATEWAY_PORT=50051
# CONNECTOR_PUBLIC_GATEWAY_ADDRESS=connect.example.com:443   # what clients put in their connector settings
# What the connector install screen tells a client to run (all optional):
# CONNECTOR_IMAGE=vizai/connector
# CONNECTOR_DOWNLOAD_URL=https://downloads.vizai.ai/connector
# CONNECTOR_RELEASE_VERSION=0.6.0
# CONNECTOR_INSTALL_ENV=VIZAI_TLS_CA_FILE=/path/to/ca.pem   # extra VIZAI_* settings, local testing only
# CONNECTOR_GATEWAY_TLS_CERT_FILE=/etc/vizai/gateway.crt
# CONNECTOR_GATEWAY_TLS_KEY_FILE=/etc/vizai/gateway.key
# CONNECTOR_GATEWAY_REQUIRE_TLS=true
